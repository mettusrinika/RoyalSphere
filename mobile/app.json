{
    "expo":  {
                 "name":  "OMIQORA",
                 "slug":  "omiqora",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "scheme":  "omiqora",
                 "userInterfaceStyle":  "dark",
                 "icon":  "./assets/omiqora-icon.png",
                 "plugins":  [
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#01030F",
                                         "image":  "./assets/omiqora-icon.png",
                                         "imageWidth":  220,
                                         "resizeMode":  "contain"
                                     }
                                 ],
                                 "@react-native-community/datetimepicker",
                                 "expo-router"
                             ],
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.omiqora.app"
                         },
                 "android":  {
                                 "package":  "com.omiqora.app",
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/omiqora-icon.png",
                                                      "backgroundColor":  "#01030F"
                                                  },
                                 "googleServicesFile":  "./google-services.json"
                             },
                 "web":  {
                             "favicon":  "./assets/omiqora-icon.png"
                         },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "ee32a5cf-b1f6-4bd5-9da9-bf3696e03e61"
                                       }
                           },
                 "owner":  "srinikamettu"
             }
}
